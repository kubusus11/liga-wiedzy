// Skopiuj ten plik jako Config/Secrets.xcconfig i uzupełnij dane projektu Supabase.
// UWAGA: w plikach .xcconfig "//" rozpoczyna komentarz, dlatego adres URL zapisz z "$()" po "https:":
//   SUPABASE_URL = https:/$()/twoj-projekt.supabase.co

SUPABASE_URL = https:/$()/TWOJ-PROJEKT.supabase.co
SUPABASE_ANON_KEY = TWOJ_ANON_KEY

// Opcjonalnie: własny identyfikator aplikacji (wymagany unikalny przy podpisywaniu darmowym Apple ID)
// QV_BUNDLE_ID = pl.twojanazwa.quizverse
